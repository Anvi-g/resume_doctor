# =====================================================================
# Azure AI-103 "Resume Doctor" - Agentic Edition
# Configuration for the Azure AI Foundry supervisor agent + 4 worker tools
# =====================================================================

# ---- Azure AI Foundry Project (Agent Service) ----
# The AI Project endpoint for the Foundry hub. This is what makes the run
# AGENTIC: a real Azure AI Foundry Agent Service supervisor drives the tools.
# Find it at ai.azure.com -> your project -> Overview -> "Project endpoint"
# (e.g. https://yourproject.eastus2.aiservices.azure.com/)
#
# Leave empty (or unset) to run in deterministic OFFLINE fallback mode.
AZURE_AI_PROJECT_ENDPOINT=

# Model deployment name inside that project (chat completions).
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# The supervisor agent name; created automatically on first connection.
AZURE_AGENT_NAME=resume-doctor

# Force deterministic offline mode even if the endpoint is set (debugging/demo).
# 0 = auto, 1 = force offline.
FORCE_OFFLINE=0

# ---- Azure AI Document Intelligence (Worker tool: parse_resume) ----
AZURE_DOC_INTEL_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your_doc_intel_key_here

# ---- Azure AI Language Service (Worker tool: redact_pii) ----
AZURE_AI_LANG_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com/
AZURE_AI_LANG_KEY=your_language_key_here

# ---- Azure OpenAI Service (Worker tool: score_ats) ----
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ---- API Gateway Configuration (Member 4) ----
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173